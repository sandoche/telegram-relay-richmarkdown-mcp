{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "..",
    "paths": { "@/*": ["../*"] },
    "outDir": ".compiled"
  },
  "include": ["../lib/**/*.ts", "../app/[accessKey]/[transport]/route.ts"]
}
